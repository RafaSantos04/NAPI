# Copy this file outside the repository or enter the values in Portainer.
# Never commit the populated version.
NAPI_IMAGE_TAG=latest
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_URL=https://napi.example.com
APP_PORT=8006
SESSION_SECURE_COOKIE=true

DB_DATABASE=napi
DB_USERNAME=napi
DB_PASSWORD=GENERATE_A_LONG_UNIQUE_PASSWORD

# Exact source IP seen for requests made by Nginx Proxy Manager. Confirm it in
# the app access log after the first proxy request; never use `*`.
TRUSTED_PROXIES=192.0.2.10

# Required only on the first successful boot. Remove the password from the
# stack environment after confirming the administrator can sign in.
NAPI_BOOTSTRAP_ADMIN_NAME=NAPI Administrator
NAPI_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
NAPI_BOOTSTRAP_ADMIN_PASSWORD=GENERATE_A_UNIQUE_PASSWORD_WITH_12_OR_MORE_CHARACTERS

